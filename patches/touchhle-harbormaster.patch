+/// For use by the run loop: performs UIKit's deferred layout pass, sending
+/// `layoutSubviews` to every view marked with `setNeedsLayout` since the last
+/// pass (views added to a hierarchy, resized views, explicit requests).
+/// Without this, views created after launch would never be laid out, e.g.
+/// the classic `EAGLView` that creates its framebuffer in `layoutSubviews`.
+pub fn run_pending_layouts(env: &mut Environment) {
+    // Layout can mark further views, so loop until settled (bounded, in case
+    // an app re-marks itself from inside its own layoutSubviews).
+    for _ in 0..8 {
+        let pending = std::mem::take(&mut env.framework_state.uikit.ui_view.needs_layout);
+        if pending.is_empty() {
+            return;
+        }
+        for view in pending {
+            () = msg![env; view layoutSubviews];
+        }
+    }
+}
+
+fn set_needs_layout(env: &mut Environment, view: id) {
+    let pending = &mut env.framework_state.uikit.ui_view.needs_layout;
+    if !pending.contains(&view) {
+        pending.push(view);
+    }
+}
