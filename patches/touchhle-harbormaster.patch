+//! `UITableView`.
+//!
+//! A deliberately simple implementation: every row's cell is created on
+//! `reloadData` (no cell reuse, `dequeueReusableCellWithIdentifier:` always
+//! returns nil, which apps must handle anyway), rows are stacked vertically
+//! inside the scroll view's content, and a touch that ends without dragging
+//! selects the row it started on.
+
+use super::UIScrollViewHostObject;
+use crate::frameworks::core_graphics::{CGFloat, CGPoint, CGRect, CGSize};
+use crate::frameworks::foundation::{ns_array, NSInteger, NSUInteger};
+use crate::frameworks::uikit::ui_view::ui_table_view_cell::DEFAULT_ROW_HEIGHT;
+use crate::objc::{
+    autorelease, id, impl_HostObject_with_superclass, msg, msg_class, msg_super, nil,
+    objc_classes, release, retain, todo_objc_setter, ClassExports, NSZonePtr, SEL,
+};
+use crate::Environment;
+
+type UITableViewStyle = NSInteger;
+const UITableViewStylePlain: UITableViewStyle = 0;
+
+type UITableViewScrollPosition = NSInteger;
+const UITableViewScrollPositionNone: UITableViewScrollPosition = 0;
+const UITableViewScrollPositionTop: UITableViewScrollPosition = 1;
+const UITableViewScrollPositionMiddle: UITableViewScrollPosition = 2;
+const UITableViewScrollPositionBottom: UITableViewScrollPosition = 3;
+
+/// Finger movement (in points) after which a touch counts as a drag, not a tap.
+const TAP_SLOP: CGFloat = 10.0;
+
+struct Row {
+    section: NSUInteger,
+    row: NSUInteger,
+    y: CGFloat,
+    height: CGFloat,
+    /// `UITableViewCell*`, strong
+    cell: id,
+}
+
+pub struct UITableViewHostObject {
+    superclass: UIScrollViewHostObject,
+    style: UITableViewStyle,
+    /// UITableViewDataSource, weak reference
+    data_source: id,
+    row_height: CGFloat,
+    section_header_height: CGFloat,
+    section_footer_height: CGFloat,
+    /// The following three are strong references.
+    header_view: id,
+    footer_view: id,
+    background_view: id,
+    rows: Vec<Row>,
+    /// Section header/footer views from the delegate, strong references.
+    section_views: Vec<id>,
+    selected: Option<(NSUInteger, NSUInteger)>,
+    allows_selection: bool,
+    loaded: bool,
+    touch_start: CGPoint,
+    touch_moved: bool,
+}
+impl_HostObject_with_superclass!(UITableViewHostObject);
+impl Default for UITableViewHostObject {
+    fn default() -> Self {
+        UITableViewHostObject {
+            superclass: Default::default(),
+            style: UITableViewStylePlain,
+            data_source: nil,
+            row_height: DEFAULT_ROW_HEIGHT,
+            section_header_height: 0.0,
+            section_footer_height: 0.0,
+            header_view: nil,
+            footer_view: nil,
+            background_view: nil,
+            rows: Vec::new(),
+            section_views: Vec::new(),
+            selected: None,
+            allows_selection: true,
+            loaded: false,
+            touch_start: CGPoint { x: 0.0, y: 0.0 },
+            touch_moved: false,
+        }
+    }
+}
+
+fn host(env: &mut Environment, table: id) -> &mut UITableViewHostObject {
+    env.objc.borrow_mut::<UITableViewHostObject>(table)
+}
+
+fn responds(env: &mut Environment, obj: id, selector: &str) -> bool {
+    if obj == nil {
+        return false;
+    }
+    let sel: SEL = env
+        .objc
+        .register_host_selector(selector.to_string(), &mut env.mem);
+    msg![env; obj respondsToSelector:sel]
+}
+
+fn index_path(env: &mut Environment, section: NSUInteger, row: NSUInteger) -> id {
+    msg_class![env; NSIndexPath indexPathForRow:row inSection:section]
+}
+
+fn index_path_parts(env: &mut Environment, path: id) -> (NSUInteger, NSUInteger) {
+    let section: NSInteger = msg![env; path section];
+    let row: NSInteger = msg![env; path row];
+    (section as NSUInteger, row as NSUInteger)
+}
+
+fn find_row(env: &mut Environment, this: id, section: NSUInteger, row: NSUInteger) -> Option<usize> {
+    host(env, this)
+        .rows
+        .iter()
+        .position(|r| r.section == section && r.row == row)
+}
+
+fn width(env: &mut Environment, this: id) -> CGFloat {
+    let bounds: CGRect = msg![env; this bounds];
+    bounds.size.width
+}
+
+/// Keeps the background view filling the visible area, behind everything.
+fn pin_background(env: &mut Environment, this: id) {
+    let background = host(env, this).background_view;
+    if background == nil {
+        return;
+    }
+    let bounds: CGRect = msg![env; this bounds];
+    () = msg![env; background setFrame:bounds];
+    () = msg![env; this sendSubviewToBack:background];
+}
+
+fn clear_content(env: &mut Environment, this: id) {
+    let rows = std::mem::take(&mut host(env, this).rows);
+    let section_views = std::mem::take(&mut host(env, this).section_views);
+    for view in rows.into_iter().map(|r| r.cell).chain(section_views) {
+        () = msg![env; view removeFromSuperview];
+        release(env, view);
+    }
+}
+
+/// Asks the delegate for a section header/footer view and places it.
+fn add_section_view(
+    env: &mut Environment,
+    this: id,
+    section: NSUInteger,
+    y: &mut CGFloat,
+    is_header: bool,
+) {
+    let delegate: id = msg![env; this delegate];
+    let (height_sel, view_sel, default_height) = if is_header {
+        (
+            "tableView:heightForHeaderInSection:",
+            "tableView:viewForHeaderInSection:",
+            host(env, this).section_header_height,
+        )
+    } else {
+        (
+            "tableView:heightForFooterInSection:",
+            "tableView:viewForFooterInSection:",
+            host(env, this).section_footer_height,
+        )
+    };
+    let section = section as NSInteger;
+    let height: CGFloat = if !responds(env, delegate, height_sel) {
+        default_height
+    } else if is_header {
+        msg![env; delegate tableView:this heightForHeaderInSection:section]
+    } else {
+        msg![env; delegate tableView:this heightForFooterInSection:section]
+    };
+    let view: id = if !responds(env, delegate, view_sel) {
+        nil
+    } else if is_header {
+        msg![env; delegate tableView:this viewForHeaderInSection:section]
+    } else {
+        msg![env; delegate tableView:this viewForFooterInSection:section]
+    };
+    if view != nil {
+        retain(env, view);
+        let frame = CGRect {
+            origin: CGPoint { x: 0.0, y: *y },
+            size: CGSize { width: width(env, this), height },
+        };
+        () = msg![env; view setFrame:frame];
+        () = msg![env; this addSubview:view];
+        host(env, this).section_views.push(view);
+    }
+    *y += height;
+}
+
+fn place_full_width(env: &mut Environment, this: id, view: id, y: &mut CGFloat) {
+    if view == nil {
+        return;
+    }
+    let mut frame: CGRect = msg![env; view frame];
+    frame.origin = CGPoint { x: 0.0, y: *y };
+    frame.size.width = width(env, this);
+    () = msg![env; view setFrame:frame];
+    () = msg![env; this addSubview:view];
+    *y += frame.size.height;
+}
+
+fn reload(env: &mut Environment, this: id) {
+    clear_content(env, this);
+    host(env, this).loaded = true;
+
+    let data_source = host(env, this).data_source;
+    let delegate: id = msg![env; this delegate];
+    let table_width = width(env, this);
+    let mut y: CGFloat = 0.0;
+
+    let header_view = host(env, this).header_view;
+    place_full_width(env, this, header_view, &mut y);
+
+    let sections: NSInteger = if data_source == nil {
+        0
+    } else if responds(env, data_source, "numberOfSectionsInTableView:") {
+        msg![env; data_source numberOfSectionsInTableView:this]
+    } else {
+        1
+    };
+    let custom_heights = responds(env, delegate, "tableView:heightForRowAtIndexPath:");
+    let will_display = responds(env, delegate, "tableView:willDisplayCell:forRowAtIndexPath:");
+    let selected = host(env, this).selected;
+
+    for section in 0..(sections.max(0) as NSUInteger) {
+        add_section_view(env, this, section, &mut y, true);
+        let rows: NSInteger =
+            msg![env; data_source tableView:this numberOfRowsInSection:(section as NSInteger)];
+        for row in 0..(rows.max(0) as NSUInteger) {
+            let path = index_path(env, section, row);
+            let height: CGFloat = if custom_heights {
+                msg![env; delegate tableView:this heightForRowAtIndexPath:path]
+            } else {
+                host(env, this).row_height
+            };
+            let cell: id = msg![env; data_source tableView:this cellForRowAtIndexPath:path];
+            assert!(cell != nil, "tableView:cellForRowAtIndexPath: returned nil");
+            retain(env, cell);
+            let frame = CGRect {
+                origin: CGPoint { x: 0.0, y },
+                size: CGSize { width: table_width, height },
+            };
+            () = msg![env; cell setFrame:frame];
+            if selected == Some((section, row)) {
+                () = msg![env; cell setSelected:true animated:false];
+            }
+            if will_display {
+                () = msg![env; delegate tableView:this willDisplayCell:cell forRowAtIndexPath:path];
+            }
+            () = msg![env; this addSubview:cell];
+            host(env, this).rows.push(Row { section, row, y, height, cell });
+            y += height;
+        }
+        add_section_view(env, this, section, &mut y, false);
+    }
+
+    let footer_view = host(env, this).footer_view;
+    place_full_width(env, this, footer_view, &mut y);
+
+    let content_size = CGSize { width: table_width, height: y };
+    () = msg![env; this setContentSize:content_size];
+
+    // Keep the current scroll position valid for the new content.
+    let bounds: CGRect = msg![env; this bounds];
+    let offset: CGPoint = msg![env; this contentOffset];
+    let max_y = (content_size.height - bounds.size.height).max(0.0);
+    if offset.y > max_y {
+        () = msg![env; this setContentOffset:(CGPoint { x: offset.x, y: max_y })];
+    }
+    pin_background(env, this);
+}
+
+fn ensure_loaded(env: &mut Environment, this: id) {
+    if !host(env, this).loaded {
+        reload(env, this);
+    }
+}
+
+/// Re-lays out after a header/footer change, if rows were already built.
+fn relayout_if_loaded(env: &mut Environment, this: id) {
+    if host(env, this).loaded {
+        reload(env, this);
+    }
+}
+
+fn set_selected(env: &mut Environment, this: id, new: Option<(NSUInteger, NSUInteger)>) {
+    let old = std::mem::replace(&mut host(env, this).selected, new);
+    if old == new {
+        return;
+    }
+    if let Some((section, row)) = old {
+        if let Some(i) = find_row(env, this, section, row) {
+            let cell = host(env, this).rows[i].cell;
+            () = msg![env; cell setSelected:false animated:false];
+        }
+    }
+    if let Some((section, row)) = new {
+        if let Some(i) = find_row(env, this, section, row) {
+            let cell = host(env, this).rows[i].cell;
+            () = msg![env; cell setSelected:true animated:false];
+        }
+    }
+}
+
+fn scroll_to_row(env: &mut Environment, this: id, index: usize, position: UITableViewScrollPosition) {
+    let (row_y, row_height) = {
+        let row = &host(env, this).rows[index];
+        (row.y, row.height)
+    };
+    let bounds: CGRect = msg![env; this bounds];
+    let content_size: CGSize = msg![env; this contentSize];
+    let visible = bounds.size.height;
+    let current = bounds.origin.y;
+    let target = match position {
+        UITableViewScrollPositionTop => row_y,
+        UITableViewScrollPositionMiddle => row_y - (visible - row_height) / 2.0,
+        UITableViewScrollPositionBottom => row_y + row_height - visible,
+        // "None": scroll the minimum amount needed to make the row visible.
+        _ if row_y < current => row_y,
+        _ if row_y + row_height > current + visible => row_y + row_height - visible,
+        _ => current,
+    };
+    let target = target.min(content_size.height - visible).max(0.0);
+    if target != current {
+        () = msg![env; this setContentOffset:(CGPoint { x: bounds.origin.x, y: target })];
+    }
+}
+
+/// Handles a tap on the cell containing `view`, like a real user selection.
+fn tap(env: &mut Environment, this: id, view: id) {
+    // Walk up from the touched view to the cell that is our direct subview.
+    let mut view = view;
+    while view != nil {
+        let superview: id = msg![env; view superview];
+        if superview == this {
+            break;
+        }
+        view = superview;
+    }
+    let Some(index) = host(env, this).rows.iter().position(|r| r.cell == view) else {
+        return;
+    };
+    let (section, row) = {
+        let r = &host(env, this).rows[index];
+        (r.section, r.row)
+    };
+    let delegate: id = msg![env; this delegate];
+    let mut path = index_path(env, section, row);
+    if responds(env, delegate, "tableView:willSelectRowAtIndexPath:") {
+        path = msg![env; delegate tableView:this willSelectRowAtIndexPath:path];
+        if path == nil {
+            return;
+        }
+    }
+    let new = index_path_parts(env, path);
+    let old = host(env, this).selected;
+    if let Some((old_section, old_row)) = old.filter(|&o| o != new) {
+        set_selected(env, this, None);
+        if responds(env, delegate, "tableView:didDeselectRowAtIndexPath:") {
+            let old_path = index_path(env, old_section, old_row);
+            () = msg![env; delegate tableView:this didDeselectRowAtIndexPath:old_path];
+        }
+    }
+    set_selected(env, this, Some(new));
+    if responds(env, delegate, "tableView:didSelectRowAtIndexPath:") {
+        () = msg![env; delegate tableView:this didSelectRowAtIndexPath:path];
+    }
+}
+
+fn touch_location(env: &mut Environment, this: id, touches: id) -> (id, CGPoint) {
+    let touch_arr: id = msg![env; touches allObjects];
+    let touch: id = msg![env; touch_arr objectAtIndex:0u32];
+    // Measure in the superview's space so scrolling doesn't skew the distance.
+    let superview: id = msg![env; this superview];
+    let reference = if superview != nil { superview } else { this };
+    let location: CGPoint = msg![env; touch locationInView:reference];
+    (touch, location)
+}
+
+pub const CLASSES: ClassExports = objc_classes! {
+
+(env, this, _cmd);
+
+@implementation UITableView: UIScrollView
+
++ (id)allocWithZone:(NSZonePtr)_zone {
+    let host_object = Box::<UITableViewHostObject>::default();
+    env.objc.alloc_object(this, host_object, &mut env.mem)
+}
+
+- (id)initWithFrame:(CGRect)frame style:(UITableViewStyle)style {
+    let this: id = msg_super![env; this initWithFrame:frame];
+    host(env, this).style = style;
+    let white: id = msg_class![env; UIColor whiteColor];
+    () = msg![env; this setBackgroundColor:white];
+    this
+}
+
+- (id)initWithFrame:(CGRect)frame {
+    msg![env; this initWithFrame:frame style:UITableViewStylePlain]
+}
+
+- (())dealloc {
+    clear_content(env, this);
+    let &mut UITableViewHostObject { header_view, footer_view, background_view, .. } = host(env, this);
+    release(env, header_view);
+    release(env, footer_view);
+    release(env, background_view);
+    msg_super![env; this dealloc]
+}
+
+- (UITableViewStyle)style {
+    host(env, this).style
+}
+
+- (id)dataSource {
+    host(env, this).data_source
+}
+- (())setDataSource:(id)data_source {
+    host(env, this).data_source = data_source;
+}
+
+- (CGFloat)rowHeight {
+    host(env, this).row_height
+}
+- (())setRowHeight:(CGFloat)height {
+    host(env, this).row_height = height;
+}
+- (())setSectionHeaderHeight:(CGFloat)height {
+    host(env, this).section_header_height = height;
+}
+- (())setSectionFooterHeight:(CGFloat)height {
+    host(env, this).section_footer_height = height;
+}
+
+- (())setSeparatorStyle:(NSInteger)style {
+    // TODO: draw separators between rows
+    todo_objc_setter!(this, style);
+}
+- (())setSeparatorColor:(id)color {
+    todo_objc_setter!(this, color);
+}
+
+- (())setAllowsSelection:(bool)allows {
+    host(env, this).allows_selection = allows;
+}
+- (bool)allowsSelection {
+    host(env, this).allows_selection
+}
+
+- (id)tableHeaderView {
+    host(env, this).header_view
+}
+- (())setTableHeaderView:(id)view { // UIView*
+    retain(env, view);
+    let old = std::mem::replace(&mut host(env, this).header_view, view);
+    if old != nil {
+        () = msg![env; old removeFromSuperview];
+        release(env, old);
+    }
+    relayout_if_loaded(env, this);
+}
+
+- (id)tableFooterView {
+    host(env, this).footer_view
+}
+- (())setTableFooterView:(id)view { // UIView*
+    retain(env, view);
+    let old = std::mem::replace(&mut host(env, this).footer_view, view);
+    if old != nil {
+        () = msg![env; old removeFromSuperview];
+        release(env, old);
+    }
+    relayout_if_loaded(env, this);
+}
+
+- (id)backgroundView {
+    host(env, this).background_view
+}
+- (())setBackgroundView:(id)view { // UIView*
+    retain(env, view);
+    let old = std::mem::replace(&mut host(env, this).background_view, view);
+    if old != nil {
+        () = msg![env; old removeFromSuperview];
+        release(env, old);
+    }
+    if view != nil {
+        () = msg![env; this addSubview:view];
+        pin_background(env, this);
+    }
+}
+
+- (())setContentOffset:(CGPoint)offset {
+    () = msg_super![env; this setContentOffset:offset];
+    pin_background(env, this);
+}
+
+- (())reloadData {
+    reload(env, this);
+}
+
+// Like UIKit, build the rows on first layout if reloadData wasn't called.
+- (())layoutSubviews {
+    ensure_loaded(env, this);
+}
+
+- (id)dequeueReusableCellWithIdentifier:(id)_identifier { // NSString*
+    nil
+}
+
+- (NSInteger)numberOfSections {
+    ensure_loaded(env, this);
+    host(env, this).rows.iter().map(|r| r.section + 1).max().unwrap_or(0) as NSInteger
+}
+
+- (NSInteger)numberOfRowsInSection:(NSInteger)section {
+    ensure_loaded(env, this);
+    host(env, this).rows.iter().filter(|r| r.section as NSInteger == section).count() as NSInteger
+}
+
+- (id)cellForRowAtIndexPath:(id)path { // NSIndexPath*
+    let (section, row) = index_path_parts(env, path);
+    match find_row(env, this, section, row) {
+        Some(i) => host(env, this).rows[i].cell,
+        None => nil,
+    }
+}
+
+- (id)indexPathForCell:(id)cell { // UITableViewCell*
+    let found = host(env, this).rows.iter().find(|r| r.cell == cell).map(|r| (r.section, r.row));
+    match found {
+        Some((section, row)) => index_path(env, section, row),
+        None => nil,
+    }
+}
+
+- (id)visibleCells {
+    let cells: Vec<id> = host(env, this).rows.iter().map(|r| r.cell).collect();
+    for &cell in &cells {
+        retain(env, cell);
+    }
+    let array = ns_array::from_vec(env, cells);
+    autorelease(env, array)
+}
+
+- (id)indexPathForSelectedRow {
+    match host(env, this).selected {
+        Some((section, row)) => index_path(env, section, row),
+        None => nil,
+    }
+}
+
+- (())selectRowAtIndexPath:(id)path // NSIndexPath*
+                  animated:(bool)_animated
+            scrollPosition:(UITableViewScrollPosition)position {
+    if path == nil {
+        set_selected(env, this, None);
+        return;
+    }
+    ensure_loaded(env, this);
+    let (section, row) = index_path_parts(env, path);
+    set_selected(env, this, Some((section, row)));
+    if position != UITableViewScrollPositionNone {
+        if let Some(i) = find_row(env, this, section, row) {
+            scroll_to_row(env, this, i, position);
+        }
+    }
+}
+
+- (())deselectRowAtIndexPath:(id)path // NSIndexPath*
+                    animated:(bool)_animated {
+    let parts = index_path_parts(env, path);
+    if host(env, this).selected == Some(parts) {
+        set_selected(env, this, None);
+    }
+}
+
+- (())scrollToRowAtIndexPath:(id)path // NSIndexPath*
+            atScrollPosition:(UITableViewScrollPosition)position
+                    animated:(bool)_animated {
+    ensure_loaded(env, this);
+    let (section, row) = index_path_parts(env, path);
+    if let Some(i) = find_row(env, this, section, row) {
+        scroll_to_row(env, this, i, position);
+    }
+}
+
+- (())touchesBegan:(id)touches // NSSet* of UITouch*
+         withEvent:(id)_event { // UIEvent*
+    let (_, location) = touch_location(env, this, touches);
+    let host = host(env, this);
+    host.touch_start = location;
+    host.touch_moved = false;
+}
+
+- (())touchesMoved:(id)touches // NSSet* of UITouch*
+         withEvent:(id)event { // UIEvent*
+    let (_, location) = touch_location(env, this, touches);
+    let start = host(env, this).touch_start;
+    if (location.x - start.x).hypot(location.y - start.y) > TAP_SLOP {
+        host(env, this).touch_moved = true;
+    }
+    () = msg_super![env; this touchesMoved:touches withEvent:event];
+}
+
+- (())touchesEnded:(id)touches // NSSet* of UITouch*
+         withEvent:(id)_event { // UIEvent*
+    let (touch, _) = touch_location(env, this, touches);
+    let &mut UITableViewHostObject { touch_moved, allows_selection, .. } = host(env, this);
+    if touch_moved || !allows_selection {
+        return;
+    }
+    let view: id = msg![env; touch view];
+    tap(env, this, view);
+}
+
+@end
+
+};
