+//! `UITableViewCell`.
+
+use crate::frameworks::core_graphics::{CGFloat, CGPoint, CGRect, CGSize};
+use crate::frameworks::foundation::NSInteger;
+use crate::objc::{
+    id, impl_HostObject_with_superclass, msg, msg_class, msg_super, nil, objc_classes, release,
+    retain, todo_objc_setter, ClassExports, NSZonePtr,
+};
+use crate::Environment;
+
+pub type UITableViewCellStyle = NSInteger;
+const UITableViewCellStyleDefault: UITableViewCellStyle = 0;
+const UITableViewCellStyleSubtitle: UITableViewCellStyle = 3;
+
+type UITableViewCellSelectionStyle = NSInteger;
+const UITableViewCellSelectionStyleNone: UITableViewCellSelectionStyle = 0;
+const UITableViewCellSelectionStyleBlue: UITableViewCellSelectionStyle = 1;
+
+/// Row height used by iOS 3 for plain-style cells.
+pub const DEFAULT_ROW_HEIGHT: CGFloat = 44.0;
+
+pub struct UITableViewCellHostObject {
+    superclass: super::UIViewHostObject,
+    style: UITableViewCellStyle,
+    /// `NSString*`, strong
+    reuse_identifier: id,
+    /// The following views are strong references, created lazily where iOS
+    /// does so.
+    content_view: id,
+    text_label: id,
+    detail_text_label: id,
+    image_view: id,
+    background_view: id,
+    selected_background_view: id,
+    /// Fallback highlight used when the app sets no selectedBackgroundView.
+    default_selected_background_view: id,
+    selected: bool,
+    selection_style: UITableViewCellSelectionStyle,
+}
+impl_HostObject_with_superclass!(UITableViewCellHostObject);
+impl Default for UITableViewCellHostObject {
+    fn default() -> Self {
+        UITableViewCellHostObject {
+            superclass: Default::default(),
+            style: UITableViewCellStyleDefault,
+            reuse_identifier: nil,
+            content_view: nil,
+            text_label: nil,
+            detail_text_label: nil,
+            image_view: nil,
+            background_view: nil,
+            selected_background_view: nil,
+            default_selected_background_view: nil,
+            selected: false,
+            selection_style: UITableViewCellSelectionStyleBlue,
+        }
+    }
+}
+
+fn host(env: &mut Environment, cell: id) -> &mut UITableViewCellHostObject {
+    env.objc.borrow_mut::<UITableViewCellHostObject>(cell)
+}
+
+fn bounds_rect(env: &mut Environment, view: id) -> CGRect {
+    let bounds: CGRect = msg![env; view bounds];
+    CGRect {
+        origin: CGPoint { x: 0.0, y: 0.0 },
+        size: bounds.size,
+    }
+}
+
+fn new_label(env: &mut Environment, content_view: id) -> id {
+    let label: id = msg_class![env; UILabel alloc];
+    let label: id = msg![env; label initWithFrame:(CGRect::default())];
+    let clear: id = msg_class![env; UIColor clearColor];
+    () = msg![env; label setBackgroundColor:clear];
+    () = msg![env; content_view addSubview:label];
+    label
+}
+
+/// Swaps a background-style view (one that sits behind the content view).
+fn replace_background(env: &mut Environment, this: id, old: id, new: id) {
+    if old == new {
+        return;
+    }
+    if old != nil {
+        () = msg![env; old removeFromSuperview];
+        release(env, old);
+    }
+    if new != nil {
+        retain(env, new);
+        let frame = bounds_rect(env, this);
+        () = msg![env; new setFrame:frame];
+        () = msg![env; this insertSubview:new atIndex:0];
+    }
+}
+
+/// Shows the selection highlight iff the cell is selected.
+fn update_selection_display(env: &mut Environment, this: id) {
+    let &mut UITableViewCellHostObject {
+        selected,
+        selection_style,
+        selected_background_view,
+        default_selected_background_view,
+        background_view,
+        ..
+    } = host(env, this);
+
+    let highlight = if selected_background_view != nil {
+        selected_background_view
+    } else if selection_style != UITableViewCellSelectionStyleNone {
+        if default_selected_background_view == nil {
+            let view: id = msg_class![env; UIView alloc];
+            let view: id = msg![env; view initWithFrame:(CGRect::default())];
+            let color: id = if selection_style == UITableViewCellSelectionStyleBlue {
+                msg_class![env; UIColor colorWithRed:(0.02 as CGFloat) green:(0.45 as CGFloat) blue:(0.93 as CGFloat) alpha:(1.0 as CGFloat)]
+            } else {
+                msg_class![env; UIColor colorWithWhite:(0.75 as CGFloat) alpha:(1.0 as CGFloat)]
+            };
+            () = msg![env; view setBackgroundColor:color];
+            host(env, this).default_selected_background_view = view;
+            view
+        } else {
+            default_selected_background_view
+        }
+    } else {
+        nil
+    };
+
+    if highlight == nil {
+        return;
+    }
+    if selected {
+        let frame = bounds_rect(env, this);
+        () = msg![env; highlight setFrame:frame];
+        // Above the normal background, below the content.
+        let index: NSInteger = if background_view != nil { 1 } else { 0 };
+        () = msg![env; this insertSubview:highlight atIndex:index];
+        () = msg![env; highlight setHidden:false];
+    } else {
+        () = msg![env; highlight setHidden:true];
+    }
+}
+
+pub const CLASSES: ClassExports = objc_classes! {
+
+(env, this, _cmd);
+
+@implementation UITableViewCell: UIView
+
++ (id)allocWithZone:(NSZonePtr)_zone {
+    let host_object = Box::<UITableViewCellHostObject>::default();
+    env.objc.alloc_object(this, host_object, &mut env.mem)
+}
+
+- (id)initWithStyle:(UITableViewCellStyle)style
+    reuseIdentifier:(id)reuse_identifier { // NSString*
+    let frame = CGRect {
+        origin: CGPoint { x: 0.0, y: 0.0 },
+        size: CGSize { width: 320.0, height: DEFAULT_ROW_HEIGHT },
+    };
+    let this: id = msg_super![env; this initWithFrame:frame];
+    let reuse_identifier: id = msg![env; reuse_identifier copy];
+    host(env, this).style = style;
+    host(env, this).reuse_identifier = reuse_identifier;
+
+    // Before iOS 7, cells show the table view's background (Apple docs:
+    // "in earlier versions of iOS, cells inherit the background color of
+    // the enclosing table view"), so they must not paint their own.
+    let clear: id = msg_class![env; UIColor clearColor];
+    () = msg![env; this setBackgroundColor:clear];
+    () = msg![env; this setOpaque:false];
+
+    let content_view: id = msg_class![env; UIView alloc];
+    let content_view: id = msg![env; content_view initWithFrame:frame];
+    let clear: id = msg_class![env; UIColor clearColor];
+    () = msg![env; content_view setBackgroundColor:clear];
+    () = msg![env; this addSubview:content_view];
+    host(env, this).content_view = content_view;
+    this
+}
+
+// iPhone OS 2.x initializer, deprecated in 3.0 but still used by many apps.
+- (id)initWithFrame:(CGRect)frame
+    reuseIdentifier:(id)reuse_identifier { // NSString*
+    let this: id = msg![env; this initWithStyle:UITableViewCellStyleDefault
+                                reuseIdentifier:reuse_identifier];
+    () = msg![env; this setFrame:frame];
+    this
+}
+
+- (id)initWithFrame:(CGRect)frame {
+    msg![env; this initWithFrame:frame reuseIdentifier:nil]
+}
+
+- (())dealloc {
+    let &mut UITableViewCellHostObject {
+        reuse_identifier,
+        content_view,
+        text_label,
+        detail_text_label,
+        image_view,
+        background_view,
+        selected_background_view,
+        default_selected_background_view,
+        ..
+    } = host(env, this);
+    for obj in [
+        reuse_identifier,
+        content_view,
+        text_label,
+        detail_text_label,
+        image_view,
+        background_view,
+        selected_background_view,
+        default_selected_background_view,
+    ] {
+        release(env, obj);
+    }
+    msg_super![env; this dealloc]
+}
+
+- (id)reuseIdentifier {
+    host(env, this).reuse_identifier
+}
+
+- (())prepareForReuse {
+}
+
+- (id)contentView {
+    host(env, this).content_view
+}
+
+- (id)textLabel {
+    let existing = host(env, this).text_label;
+    if existing != nil {
+        return existing;
+    }
+    let content_view = host(env, this).content_view;
+    let label = new_label(env, content_view);
+    host(env, this).text_label = label;
+    () = msg![env; this setNeedsLayout];
+    label
+}
+
+- (id)detailTextLabel {
+    let existing = host(env, this).detail_text_label;
+    if existing != nil || host(env, this).style == UITableViewCellStyleDefault {
+        // The default style has no detail label on iOS either.
+        return existing;
+    }
+    let content_view = host(env, this).content_view;
+    let label = new_label(env, content_view);
+    host(env, this).detail_text_label = label;
+    () = msg![env; this setNeedsLayout];
+    label
+}
+
+- (id)imageView {
+    let existing = host(env, this).image_view;
+    if existing != nil {
+        return existing;
+    }
+    let image_view: id = msg_class![env; UIImageView alloc];
+    let image_view: id = msg![env; image_view initWithFrame:(CGRect::default())];
+    let content_view = host(env, this).content_view;
+    () = msg![env; content_view addSubview:image_view];
+    host(env, this).image_view = image_view;
+    image_view
+}
+
+// iPhone OS 2.x-style convenience accessors.
+- (())setText:(id)text { // NSString*
+    let label: id = msg![env; this textLabel];
+    () = msg![env; label setText:text];
+}
+- (())setImage:(id)image { // UIImage*
+    let image_view: id = msg![env; this imageView];
+    () = msg![env; image_view setImage:image];
+    () = msg![env; this setNeedsLayout];
+}
+
+- (id)backgroundView {
+    host(env, this).background_view
+}
+- (())setBackgroundView:(id)new_view { // UIView*
+    let old = std::mem::replace(&mut host(env, this).background_view, new_view);
+    replace_background(env, this, old, new_view);
+}
+
+- (id)selectedBackgroundView {
+    host(env, this).selected_background_view
+}
+- (())setSelectedBackgroundView:(id)new_view { // UIView*
+    let old = std::mem::replace(&mut host(env, this).selected_background_view, new_view);
+    replace_background(env, this, old, new_view);
+    update_selection_display(env, this);
+}
+
+- (bool)isSelected {
+    host(env, this).selected
+}
+- (())setSelected:(bool)selected {
+    msg![env; this setSelected:selected animated:false]
+}
+- (())setSelected:(bool)selected animated:(bool)_animated {
+    host(env, this).selected = selected;
+    update_selection_display(env, this);
+}
+- (())setHighlighted:(bool)highlighted animated:(bool)_animated {
+    todo_objc_setter!(this, highlighted);
+}
+
+- (UITableViewCellSelectionStyle)selectionStyle {
+    host(env, this).selection_style
+}
+- (())setSelectionStyle:(UITableViewCellSelectionStyle)style {
+    host(env, this).selection_style = style;
+    update_selection_display(env, this);
+}
+
+- (())setAccessoryType:(NSInteger)accessory_type {
+    // TODO: draw disclosure indicators/checkmarks
+    todo_objc_setter!(this, accessory_type);
+}
+- (())setAccessoryView:(id)accessory_view {
+    todo_objc_setter!(this, accessory_view);
+}
+
+- (())layoutSubviews {
+    let bounds = bounds_rect(env, this);
+    let &mut UITableViewCellHostObject {
+        style,
+        content_view,
+        text_label,
+        detail_text_label,
+        image_view,
+        background_view,
+        selected_background_view,
+        default_selected_background_view,
+        ..
+    } = host(env, this);
+    for view in [background_view, selected_background_view, default_selected_background_view] {
+        if view != nil {
+            () = msg![env; view setFrame:bounds];
+        }
+    }
+    if content_view == nil {
+        return;
+    }
+    () = msg![env; content_view setFrame:bounds];
+
+    let margin: CGFloat = 10.0;
+    let mut text_x = margin;
+    if image_view != nil {
+        let image: id = msg![env; image_view image];
+        if image != nil {
+            let size: CGSize = msg![env; image size];
+            let frame = CGRect {
+                origin: CGPoint { x: margin, y: (bounds.size.height - size.height) / 2.0 },
+                size,
+            };
+            () = msg![env; image_view setFrame:frame];
+            text_x = margin * 2.0 + size.width;
+        }
+    }
+    let text_width = (bounds.size.width - text_x - margin).max(0.0);
+    let has_detail_below = style == UITableViewCellStyleSubtitle && detail_text_label != nil;
+    if text_label != nil {
+        let height = if has_detail_below { bounds.size.height * 0.55 } else { bounds.size.height };
+        let frame = CGRect {
+            origin: CGPoint { x: text_x, y: 0.0 },
+            size: CGSize { width: text_width, height },
+        };
+        () = msg![env; text_label setFrame:frame];
+    }
+    if detail_text_label != nil {
+        let frame = if has_detail_below {
+            CGRect {
+                origin: CGPoint { x: text_x, y: bounds.size.height * 0.55 },
+                size: CGSize { width: text_width, height: bounds.size.height * 0.45 },
+            }
+        } else {
+            // Value1/Value2: detail on the right half.
+            CGRect {
+                origin: CGPoint { x: text_x + text_width / 2.0, y: 0.0 },
+                size: CGSize { width: text_width / 2.0, height: bounds.size.height },
+            }
+        };
+        () = msg![env; detail_text_label setFrame:frame];
+    }
+}
+
+@end
+
+};
